// Despliegue en Cloudflare Workers (archivos estáticos). El build lo hace `npm run build`.
{
  "name": "macro-quest-app",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // SPA: cualquier ruta que no sea un archivo devuelve index.html (sustituye al antiguo _redirects).
    "not_found_handling": "single-page-application"
  }
}
