// Despliegue en Cloudflare Workers. El build lo hace `npm run build`.
{
  "name": "macro-quest-app",
  "compatibility_date": "2026-10-01",
  // Worker: intermediario de Open Food Facts (/api/off/*) y login con Google (/api/auth/*).
  "main": "worker/index.ts",
  // Los secretos GOOGLE_CLIENT_ID y GOOGLE_CLIENT_SECRET se ponen en el panel de Cloudflare; no se pisan al desplegar.
  "keep_vars": true,
  // Registros del worker en el panel (p. ej. por qué falla un login).
  "observability": { "enabled": true },
  // Dominio propio (comprado en Cloudflare Registrar). Cloudflare crea el DNS y el certificado. workers.dev sigue activo.
  "routes": [{ "pattern": "macroquestapp.com", "custom_domain": true }],
  // Con rutas propias, workers.dev hay que dejarlo activo a mano (lo usan las cuentas e instalaciones de antes).
  "workers_dev": true,
  // Usuarios y sesiones. Sin `database_id`: Cloudflare crea la base en el primer despliegue.
  "d1_databases": [{ "binding": "DB", "database_name": "macro-quest" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // SPA: cualquier ruta que no sea un archivo devuelve index.html.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
